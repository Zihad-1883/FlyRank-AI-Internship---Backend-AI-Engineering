{
  "openapi": "3.0.0",
  "info": {
    "title": "FlyRank Auth API",
    "description": "Secure API with Supabase Auth — Sign Up, Log In, Log Out, JWT verification, and protected routes",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Supabase JWT access token"
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create a new user account",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "test@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Bad request (missing email/password or invalid request)"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user & return JWT tokens",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "test@example.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully, returns access_token and refresh_token"
          },
          "400": {
            "description": "Bad request (empty fields)"
          },
          "401": {
            "description": "Unauthorized (Invalid login credentials)"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Log out user & invalidate session",
        "tags": ["Auth"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "No Content - User logged out successfully"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid Bearer token"
          },
          "400": {
            "description": "Bad request or signout failure"
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Read open public data",
        "tags": ["Public"],
        "responses": {
          "200": {
            "description": "Public info message"
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Read private profile data",
        "tags": ["Protected"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns user profile details"
          },
          "401": {
            "description": "Unauthorized - Missing or invalid token"
          }
        }
      }
    }
  }
}