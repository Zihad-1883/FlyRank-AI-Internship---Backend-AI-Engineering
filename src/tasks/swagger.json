{
  "openapi": "3.0.0",
  "info": {
    "title": "Task Manager API",
    "version": "1.0.0",
    "description": "Public task endpoint simulation and testing playground."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "summary": "Get all tasks",
        "responses": {
          "200": {
            "description": "A successful list arrays response."
          }
        }
      },
      "post": {
        "summary": "Create a new task",
        "description": "Adds a brand new task item to your list.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "The description or name of the task",
                    "example": "Buy milk"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 2 },
                    "title": { "type": "string", "example": "Buy milk" },
                    "done": { "type": "boolean", "example": false }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Title is missing."
          }
        }
      }
    }
  }
}
